<Window x:Class="PlayerokMonitor.Desktop.RelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выставить товар снова" Width="560" Height="650" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource PageBrush}" ShowInTaskbar="False">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="24" Background="{StaticResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="#10131A">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <TextBlock Text="Выставить снова" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <Button Grid.Column="1" Content="×" FontSize="20" Padding="0" BorderThickness="0" Click="CloseButton_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,26">
                    <TextBlock x:Name="ItemTitle" Text="Проверяю исходный товар…" FontSize="23" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Обложка, описание и параметры копируются сервером. Для одного заказа публикация возможна только один раз." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,20"/>
                    <TextBlock Text="Новая цена" FontWeight="SemiBold"/>
                    <TextBox x:Name="PriceBox" Margin="0,8,0,0"/>
                    <TextBlock x:Name="PriceHint" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="3,5,0,0"/>
                    <CheckBox x:Name="PremiumCheck" Content="Оплатить Premium-продвижение" Margin="0,20,0,0"/>
                    <TextBlock Text="Актуальная стоимость рассчитывается Playerok именно для новой цены. Вы увидите её до публикации." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button x:Name="PreviewButton" Style="{StaticResource AccentButton}" Content="Рассчитать условия" HorizontalAlignment="Left" Margin="0,20,0,0" Click="PreviewButton_Click"/>
                    <Border x:Name="OfferCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Условия публикации" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OfferFee" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="OfferDetails" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <Button x:Name="PublishButton" Style="{StaticResource AccentButton}" Content="Подтвердить публикацию" HorizontalAlignment="Left" Margin="0,18,0,0" Click="PublishButton_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
