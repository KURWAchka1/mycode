<Window x:Class="PlayerokMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:PlayerokMonitor.Desktop"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Playerok Monitor"
        Width="1280"
        Height="820"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource PageBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        SizeChanged="MainWindow_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact native-feeling title bar. -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Border Width="21" Height="21" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="P" Foreground="#08111E" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Playerok Monitor" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="MinimizeButton" Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" ToolTip="Свернуть">
                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE921;" FontSize="12"/>
                </Button>
                <Button Grid.Column="2" x:Name="MaximizeButton" Style="{StaticResource WindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeButton_Click" ToolTip="Развернуть">
                    <TextBlock x:Name="MaximizeIcon" Style="{StaticResource FluentIcon}" Text="&#xE922;" FontSize="12"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource CloseWindowButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" ToolTip="Закрыть">
                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8BB;" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="MainLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="62"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsed navigation rail: 49–62 px is the established desktop compact mode. -->
            <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="9,12,9,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ConnectionPill" Width="34" Height="25" CornerRadius="8" Background="#182DD17B" ToolTip="Состояние подключения">
                        <Grid>
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionText" Text="Подключение…" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,17,0,0">
                        <Button x:Name="OrdersNav" Style="{StaticResource NavButton}" Click="OrdersNav_Click" ToolTip="Заказы  ·  Ctrl+1">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8FD;"/>
                        </Button>
                        <Button x:Name="StatsNav" Style="{StaticResource NavButton}" Click="StatsNav_Click" ToolTip="Статистика  ·  Ctrl+2">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE907;"/>
                        </Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click" ToolTip="Настройки  ·  Ctrl+,">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE713;"/>
                        </Button>
                    </StackPanel>
                    <Button Grid.Row="2" Style="{StaticResource NavButton}" Click="CommandPaletteButton_Click" ToolTip="Быстрые команды  ·  Ctrl+K">
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE71D;"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- One compact command bar; no oversized hero header. -->
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Background="{StaticResource PanelBrush}">
                    <Grid Margin="18,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Заказы" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle" Text="Новые, продажи и покупки" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="UpdateBanner" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" BorderBrush="#526FA7E8" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UpdateText" Text="Доступно обновление" FontSize="12" VerticalAlignment="Center"/>
                                <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Content="Обновить" Padding="9,4" MinHeight="26" Margin="8,0,0,0" Click="InstallUpdateButton_Click"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Foreground="{StaticResource MutedBrush}" Padding="9,5" MinHeight="30" Margin="0,0,6,0" Click="CommandPaletteButton_Click" ToolTip="Открыть быстрые команды">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FluentIcon}" Text="&#xE92E;" FontSize="16"/><TextBlock Text="Ctrl K" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Grid.Column="3" x:Name="RefreshButton" Style="{StaticResource IconButton}" Click="RefreshButton_Click" ToolTip="Обновить  ·  F5">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72C;" FontSize="20"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- ORDERS -->
                    <Grid x:Name="OrdersView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Background="{StaticResource PageBrush}">
                            <Grid Margin="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="NewTab" Style="{StaticResource TabButton}" Content="Новые" Click="NewTab_Click"/>
                                    <Button x:Name="SalesTab" Style="{StaticResource TabButton}" Content="Продажи" Click="SalesTab_Click"/>
                                    <Button x:Name="PurchasesTab" Style="{StaticResource TabButton}" Content="Покупки" Click="PurchasesTab_Click"/>
                                    <Button x:Name="AllTab" Style="{StaticResource TabButton}" Content="Все" Click="AllTab_Click"/>
                                </StackPanel>
                                <Grid Grid.Column="2" x:Name="SearchContainer" Width="240" VerticalAlignment="Center">
                                    <TextBox x:Name="SearchBox"
                                             TextChanged="SearchBox_TextChanged"
                                             GotKeyboardFocus="SearchBox_FocusChanged"
                                             LostKeyboardFocus="SearchBox_FocusChanged"
                                             Padding="34,7,10,7"
                                             ToolTip="Поиск по товару, пользователю или номеру"/>
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE721;" FontSize="16" Foreground="{StaticResource SubtleBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="SearchHint" Text="Поиск заказов" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OrderListColumn" Width="42*" MinWidth="300"/>
                                <ColumnDefinition x:Name="OrderDividerColumn" Width="1"/>
                                <ColumnDefinition x:Name="OrderDetailColumn" Width="58*" MinWidth="340"/>
                            </Grid.ColumnDefinitions>

                            <Grid Background="{StaticResource PanelBrush}">
                                <ListBox x:Name="OrdersList" Margin="5,6,4,6" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OrdersList_SelectionChanged">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid Margin="0,1">
                                                            <Border x:Name="SelectionRail" Width="3" Margin="2,10,0,10" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="2" Visibility="Collapsed"/>
                                                            <Border x:Name="ItemRoot" Margin="7,0,3,0" Background="{TemplateBinding Background}" CornerRadius="8" Padding="11,9">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                                                <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions>
                                                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="ItemRoot" Property="BorderThickness" Value="1"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="49">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <emoji:TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding DirectionLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="  ·  " Foreground="{StaticResource SubtleBrush}" FontSize="11"/>
                                                         <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                        <TextBlock Text="{Binding ReviewStars}" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding PriceDisplay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CounterpartyDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="EmptyOrders" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE930;" FontSize="24" Foreground="{StaticResource GreenBrush}"/>
                                    <TextBlock x:Name="EmptyOrdersText" Text="Новых заказов нет" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="Можно выдохнуть" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Background="{StaticResource DividerBrush}"/>

                            <Grid Grid.Column="2" Background="{StaticResource PageBrush}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="22,18,20,22">
                                        <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Выберите заказ" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Статусы и действия появятся здесь" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="OrderDetails" Visibility="Collapsed">
                                            <TextBlock x:Name="DetailDirection" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                            <emoji:TextBlock x:Name="DetailTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="DetailPrice" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                            <WrapPanel Margin="0,14,0,0">
                                                <Button x:Name="OpenDealButton" Margin="0,0,7,7" Click="OpenDealButton_Click">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Открыть Playerok"/><TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8A7;" FontSize="16" Margin="7,0,0,0"/></StackPanel>
                                                </Button>
                                                <Button x:Name="WakeButton" Style="{StaticResource AccentButton}" Content="Я проснулся" Margin="0,0,7,7" Click="WakeButton_Click" Visibility="Collapsed"/>
                                                <Button x:Name="RelistButton" Style="{StaticResource AccentButton}" Content="Выставить снова" Margin="0,0,7,7" Click="RelistButton_Click" Visibility="Collapsed"/>
                                            </WrapPanel>
                                            <StackPanel x:Name="DetailFields" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- STATISTICS: useful information, calculated and animated locally. -->
                    <ScrollViewer x:Name="StatsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="18,16,18,20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <UniformGrid x:Name="StatsMetricsGrid" Columns="4">
                                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Чистыми · 14 дней" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatNet" Text="0 ₽" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Продажи" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatSales" Text="0" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Средний доход" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatAverage" Text="0 ₽" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Завершение" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatCompletion" Text="0%" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                            </UniformGrid>
                            <Grid x:Name="StatsContentGrid" Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="StatsChartPanel" Style="{StaticResource Card}">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Динамика дохода" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="14 дней · без запросов к VPS" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><local:StatisticsChart x:Name="RevenueChart" Grid.Row="1" Height="300" Margin="0,10,0,0"/></Grid>
                                </Border>
                                <Border x:Name="StatsStatusPanel" Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Состояние" FontSize="15" FontWeight="SemiBold"/>
                                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Нужно выполнить" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" x:Name="StatNew" FontSize="15" FontWeight="SemiBold"/></Grid>
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Проблемы" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" x:Name="StatProblems" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"/></Grid>
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Возвраты" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" x:Name="StatReturns" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}"/></Grid>
                                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Покупки" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" x:Name="StatPurchases" FontSize="15" FontWeight="SemiBold"/></Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- SETTINGS: compact rows, descriptions on the left and actions on the right. -->
                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="18,16,18,28">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Подключение" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Используется тот же Pairing URL, что и на Android. Токен зашифрован для текущего пользователя Windows." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <TextBox x:Name="PairingUrlBox"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Проверить и сохранить" Click="SaveConnectionButton_Click"/>
                                        <Button Content="Тест уведомления" Margin="7,0,0,0" Click="TestNotificationButton_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="NotificationStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,7,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Приложение" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Мониторинг" FontWeight="SemiBold"/><TextBlock Text="Получать новые события в фоне" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="MonitoringCheck" VerticalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                    <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Системные уведомления" FontWeight="SemiBold"/><TextBlock Text="Показывать события в центре уведомлений Windows" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="NotificationsCheck" VerticalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                    <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Автозапуск" FontWeight="SemiBold"/><TextBlock Text="Запускать Playerok Monitor вместе с Windows" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoStartCheck" VerticalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}"/>
                                    <Grid Margin="0,7,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Закрытие в трей" FontWeight="SemiBold"/><TextBlock Text="Оставлять мониторинг активным после закрытия окна" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="CloseToTrayCheck" VerticalAlignment="Center"/></Grid>
                                    <Button Content="Сохранить параметры" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveWindowsSettingsButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Автосообщения" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Общие с Android · отправителем остаётся сервер" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Загрузить заново" Padding="9,5" MinHeight="30" Click="LoadRepliesButton_Click"/>
                                    </Grid>
                                    <Grid Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Отключить все сообщения" FontWeight="SemiBold"/><TextBlock Text="Тексты сохранятся и вернутся после включения" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="DisableRepliesCheck" VerticalAlignment="Center"/></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}"/>

                                    <TextBlock Text="После оплаты" FontWeight="SemiBold" Margin="0,14,0,7"/>
                                    <TextBlock Text="Можно добавить до восьми сообщений. Пустое первое поле использует серверный текст по умолчанию." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="MessagesPanel"/>
                                    <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,2,0,0" Padding="7,5" Click="AddMessageButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FluentIcon}" Text="&#xE710;" FontSize="16"/><TextBlock Text="Добавить сообщение" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>

                                    <TextBlock Text="После подтверждения выполнения вами" FontWeight="SemiBold" Margin="0,16,0,7"/>
                                    <emoji:RichTextBox x:Name="FulfillmentMessageBox" AcceptsReturn="True" MinHeight="64"/>
                                    <TextBlock x:Name="FulfillmentHint" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0"/>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,14"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Режим сна" FontWeight="SemiBold"/><TextBlock Text="Предупреждать покупателя, что продавец может спать" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="SleepEnabledCheck" VerticalAlignment="Center"/></Grid>
                                    <Grid Margin="0,2,0,0" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="7"/><ColumnDefinition Width="116"/><ColumnDefinition Width="7"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="С" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,3"/><ComboBox x:Name="SleepStartBox" Style="{StaticResource CompactComboBox}" Tag="&#xE917;"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="До" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,3"/><ComboBox x:Name="SleepEndBox" Style="{StaticResource CompactComboBox}" Tag="&#xE917;"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Часовой пояс" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,3"/><ComboBox x:Name="SleepTimezoneBox" Style="{StaticResource CompactComboBox}" Tag="&#xE909;"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Сообщение во время сна" FontWeight="SemiBold" Margin="0,14,0,7"/>
                                    <emoji:RichTextBox x:Name="SleepMessageBox" AcceptsReturn="True" MinHeight="64"/>
                                    <TextBlock x:Name="SleepHint" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource AccentButton}" Content="Сохранить сообщения" Click="SaveRepliesButton_Click"/>
                                        <TextBlock x:Name="RepliesStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Playerok Monitor 1.1.6 · Windows 11" Foreground="{StaticResource SubtleBrush}" FontSize="10" Margin="2,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Keyboard-first command palette. It is lazy in use and produces no server requests by itself. -->
        <Grid x:Name="CommandPaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#8A080A0D" Panel.ZIndex="1000">
            <Border Width="520" MaxHeight="460" Margin="0,94,0,0" VerticalAlignment="Top" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="CommandSearchBox"
                                 Padding="36,8,34,8"
                                 TextChanged="CommandSearchBox_TextChanged"
                                 GotKeyboardFocus="CommandSearchBox_FocusChanged"
                                 LostKeyboardFocus="CommandSearchBox_FocusChanged"
                                 KeyDown="CommandSearchBox_KeyDown"/>
                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE721;" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="CommandSearchHint" Text="Команда или раздел" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Style="{StaticResource SubtleButton}" Content="Esc" FontSize="10" Foreground="{StaticResource MutedBrush}" Padding="5,2" MinHeight="20" HorizontalAlignment="Right" Margin="0,0,8,0" Click="CloseCommandPaletteButton_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="Bold" Margin="8,10,0,5"/>
                    <ListBox Grid.Row="2" x:Name="CommandList" Background="Transparent" BorderThickness="0" MouseDoubleClick="CommandList_MouseDoubleClick" KeyDown="CommandList_KeyDown">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Padding="10,8" CornerRadius="7" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,2,0"/></Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
